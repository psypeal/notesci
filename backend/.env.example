# Postgres
DATABASE_URL=postgresql://notesci:notesci_dev@localhost:5433/notesci

# LLM provider keys — set the ones you have. Multi-provider is a hard
# requirement; the agent picks a model via NOTESCI_DEFAULT_MODEL but any
# request can override it once the API exposes that field.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Server-side fallback model — OPTIONAL.
# When unset, the backend picks the first available model based on
# whichever provider key is configured (no hardcoded preference).
# Users always choose their personal default via the in-app
# Settings → Preferences → Default Model picker; this setting only
# kicks in when a request has no per-call model AND the user has no
# saved preference. Format: "<provider>:<model_id>". Examples:
#   anthropic:claude-sonnet-4-6
#   openai:gpt-4o
#   google_genai:gemini-2.0-flash
#   deepseek:deepseek-chat        (DeepSeek-V3, general purpose)
#   deepseek:deepseek-reasoner    (DeepSeek-R1, reasoning model)
NOTESCI_DEFAULT_MODEL=

# Admin token — required header (X-Admin-Token) on /admin/* endpoints
# (workspace bootstrap). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NOTESCI_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Email — pluggable backend for transactional sends (reset / verify / invite)
# ---------------------------------------------------------------------------
# Backend selector:
#   log  : LogEmailSender (default; writes to stdout — fine for dev / CI)
#   smtp : SmtpEmailSender (real send via stdlib smtplib + STARTTLS)
NOTESCI_EMAIL_BACKEND=log

# SMTP transport — only read when NOTESCI_EMAIL_BACKEND=smtp.
# Common providers:
#   • Titan:      host=smtp.titan.email     port=587  user=<full-mailbox>
#                 (notesci's canonical setup — STARTTLS, account password)
#   • SendGrid:   host=smtp.sendgrid.net    port=587  user=apikey
#   • Postmark:   host=smtp.postmarkapp.com port=587  user=<server-token>
#   • Mailgun:    host=smtp.mailgun.org     port=587  user=<smtp-user>
#   • SES:        host=email-smtp.<region>.amazonaws.com port=587
#   • Vultr:      Vultr's VPS network blocks port 25 by default but allows
#                 587 (submission). Open a support ticket if you need 25.
NOTESCI_SMTP_HOST=
NOTESCI_SMTP_PORT=587
NOTESCI_SMTP_USER=
NOTESCI_SMTP_PASSWORD=
NOTESCI_SMTP_STARTTLS=true

# From-addresses surfaced in templates. Use addresses on a domain with
# SPF + DKIM + DMARC records pointing at your provider — bare-domain
# addresses without those records will land in spam. Titan mailboxes
# can only put themselves in the From header (unless aliases are
# configured), so for the notesci setup both default to the same
# "no-reply@notesci.com" account.
NOTESCI_EMAIL_FROM_INVITE=no-reply@notesci.com
NOTESCI_EMAIL_FROM_SECURITY=no-reply@notesci.com

# Public base URL used to build links inside email bodies (reset/verify/
# invite). Override per-environment — must be the URL the *user* sees,
# not the internal service URL.
NOTESCI_APP_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Background sweeper interval (seconds) — prunes expired sessions, ages
# out used tokens, returns stale sent invites to the issuer's pool. Set
# to 0 to disable the loop entirely (useful for tests).
# ---------------------------------------------------------------------------
NOTESCI_SWEEP_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------------
# CORS / proxy / secrets — added for security hardening.
# ---------------------------------------------------------------------------

# Comma-separated list of origins permitted to call the API. The Vite
# dev server is the default; for production set this to the user-facing
# https origin (e.g. https://app.notesci.com).
NOTESCI_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated trusted-proxy CIDRs. Only when the direct TCP peer
# is in one of these networks will the rate limiter honour the
# ``X-Forwarded-For`` header. Defaults to loopback (safe for local
# dev). In prod set to your LB / Cloudflare egress range.
NOTESCI_TRUSTED_PROXIES=127.0.0.1/8,::1/128

# Fernet symmetric key (32 url-safe-base64 bytes) used to encrypt MCP
# server config secrets (headers, env values) at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When unset, the backend logs a warning at startup and stores the
# values as plaintext — unsafe outside local dev.
NOTESCI_SECRET_KEY=
