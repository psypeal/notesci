{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "notesci",
  "version": "0.1.30",
  "identifier": "com.notesci.app",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node src-tauri/scripts/tauri-frontend.mjs dev || node scripts/tauri-frontend.mjs dev",
    "beforeBuildCommand": "node src-tauri/scripts/tauri-frontend.mjs build || node scripts/tauri-frontend.mjs build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "notesci",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#f6f4ef",
        "dragDropEnabled": false,
        "url": "/",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/pg/": "pg/",
      "resources/python/": "python/",
      "resources/backend/": "backend/",
      "resources/frontend/": "frontend/"
    },
    "targets": ["deb", "rpm", "appimage", "dmg", "app", "nsis"],
    "category": "Productivity",
    "shortDescription": "Personal research workspace",
    "longDescription": "notesci is a single-user, self-hosted research workspace that grounds chat responses in your own corpus of papers and notes. Multi-provider LLMs, MCP tools, citations, drafting pipeline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "postgresql",
          "postgresql-16-pgvector",
          "python3.12",
          "python3.12-venv",
          "libwebkit2gtk-4.1-0",
          "libsoup-3.0-0"
        ]
      },
      "rpm": {
        "depends": [
          "postgresql-server",
          "python3.12",
          "webkit2gtk4.1",
          "libsoup3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "files": {}
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
